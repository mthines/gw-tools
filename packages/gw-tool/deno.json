{
  "name": "@gw-tools/gw",
  "version": "0.9.3",
  "exports": "./src/main.ts",
  "compilerOptions": {
    "lib": ["deno.ns", "deno.window"],
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@1.0.28",
    "@std/cli/": "jsr:/@std/cli@1.0.28/",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/path": "jsr:@std/path@^1.1.4"
  },
  "lint": {
    "exclude": ["npm/"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "exclude": ["npm/"],
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "test": {
    "include": ["src/**/*.test.ts", "src/**/*.spec.ts"]
  }
}
