{
  "name": "autonomous-workflow-agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/autonomous-workflow-agent/src",
  "projectType": "library",
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/autonomous-workflow-agent",
        "main": "packages/autonomous-workflow-agent/src/index.ts",
        "tsConfig": "packages/autonomous-workflow-agent/tsconfig.lib.json",
        "assets": [
          {
            "input": "packages/autonomous-workflow-agent",
            "glob": "README.md",
            "output": "."
          }
        ]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "npm publish --access public",
        "cwd": "dist/packages/autonomous-workflow-agent"
      },
      "configurations": {
        "dry-run": {
          "command": "npm publish --access public --dry-run",
          "cwd": "dist/packages/autonomous-workflow-agent"
        }
      }
    },
    "install-local": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "echo '📦 Installing skills to ~/.agents/skills/ ...'",
          "rsync -a --delete skills/autonomous-workflow/ ~/.agents/skills/autonomous-workflow/",
          "rsync -a --delete skills/create-plan/ ~/.agents/skills/create-plan/",
          "rsync -a --delete skills/create-walkthrough/ ~/.agents/skills/create-walkthrough/",
          "rsync -a --delete skills/confidence/ ~/.agents/skills/confidence/",
          "echo '🔗 Ensuring symlinks in ~/.claude/ ...'",
          "mkdir -p ~/.claude/agents ~/.claude/skills",
          "echo '  Backward-compat: skills moved from ~/.claude/skills/ to ~/.agents/skills/ — symlinks keep old path working'",
          "ln -sfn ~/.agents/skills/autonomous-workflow ~/.claude/skills/autonomous-workflow",
          "ln -sfn ~/.agents/skills/create-plan ~/.claude/skills/create-plan",
          "ln -sfn ~/.agents/skills/create-walkthrough ~/.claude/skills/create-walkthrough",
          "ln -sfn ~/.agents/skills/confidence ~/.claude/skills/confidence",
          "ln -sf ~/.agents/skills/autonomous-workflow/templates/agent.template.md ~/.claude/agents/autonomous-workflow.md",
          "echo '✅ Done. Installed skills: autonomous-workflow, create-plan, create-walkthrough, confidence'"
        ],
        "cwd": "{workspaceRoot}",
        "parallel": false
      }
    }
  }
}
