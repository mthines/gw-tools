{
  "name": "gw-worktrees",
  "displayName": "gw - Git Worktrees",
  "description": "Manage Git worktrees and visualize autonomous agent workflows from the VS Code sidebar",
  "version": "0.8.0",
  "publisher": "mthines",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mthines/gw-tools.git",
    "directory": "packages/vscode-gw"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "worktree",
    "gw",
    "agent",
    "workflow"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "workspaceContains:.gw"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gw-worktrees",
          "title": "gw",
          "icon": "$(git-branch)"
        }
      ]
    },
    "views": {
      "gw-worktrees": [
        {
          "id": "gwWorktreeExplorer",
          "name": "Worktrees",
          "icon": "$(git-branch)",
          "contextualTitle": "gw"
        },
        {
          "id": "gwAgentTasks",
          "name": "Agent Tasks",
          "icon": "$(tasklist)",
          "contextualTitle": "Agent Tasks"
        }
      ]
    },
    "commands": [
      {
        "command": "gw.refreshWorktrees",
        "title": "Refresh Worktrees",
        "icon": "$(refresh)",
        "category": "gw"
      },
      {
        "command": "gw.openWorktree",
        "title": "Open Worktree in New Window",
        "icon": "$(window)",
        "category": "gw"
      },
      {
        "command": "gw.openWorktreeInCurrentWindow",
        "title": "Open Worktree in Current Window",
        "icon": "$(folder-opened)",
        "category": "gw"
      },
      {
        "command": "gw.removeWorktree",
        "title": "Remove Worktree",
        "icon": "$(trash)",
        "category": "gw"
      },
      {
        "command": "gw.createWorktree",
        "title": "Create Worktree",
        "icon": "$(add)",
        "category": "gw"
      },
      {
        "command": "gw.refreshAgentTasks",
        "title": "Refresh Agent Tasks",
        "icon": "$(refresh)",
        "category": "gw"
      },
      {
        "command": "gw.openPlan",
        "title": "Open Plan",
        "icon": "$(notebook)",
        "category": "gw"
      },
      {
        "command": "gw.openTask",
        "title": "Open Task File",
        "icon": "$(tasklist)",
        "category": "gw"
      },
      {
        "command": "gw.openWalkthrough",
        "title": "Open Walkthrough",
        "icon": "$(book)",
        "category": "gw"
      },
      {
        "command": "gw.clean",
        "title": "Clean Stale Worktrees",
        "icon": "$(clear-all)",
        "category": "gw"
      },
      {
        "command": "gw.sortAgentTasks",
        "title": "Sort Agent Tasks",
        "icon": "$(list-ordered)",
        "category": "gw"
      },
      {
        "command": "gw.sync",
        "title": "Sync Files to Worktree",
        "icon": "$(sync)",
        "category": "gw"
      },
      {
        "command": "gw.switchWorktree",
        "title": "Switch Worktree",
        "icon": "$(list-selection)",
        "category": "gw"
      },
      {
        "command": "gw.focus",
        "title": "Focus gw Sidebar",
        "icon": "$(git-branch)",
        "category": "gw"
      },
      {
        "command": "gw.focusWorktrees",
        "title": "Focus Worktrees View",
        "icon": "$(git-branch)",
        "category": "gw"
      },
      {
        "command": "gw.focusAgentTasks",
        "title": "Focus Agent Tasks View",
        "icon": "$(tasklist)",
        "category": "gw"
      },
      {
        "command": "gw.update",
        "title": "Update Worktree",
        "icon": "$(cloud-download)",
        "category": "gw"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "gw.openPlan",
          "when": "false"
        },
        {
          "command": "gw.openTask",
          "when": "false"
        },
        {
          "command": "gw.openWalkthrough",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "gw.refreshWorktrees",
          "when": "view == gwWorktreeExplorer",
          "group": "navigation"
        },
        {
          "command": "gw.createWorktree",
          "when": "view == gwWorktreeExplorer",
          "group": "navigation"
        },
        {
          "command": "gw.clean",
          "when": "view == gwWorktreeExplorer",
          "group": "navigation"
        },
        {
          "command": "gw.update",
          "when": "view == gwWorktreeExplorer",
          "group": "navigation"
        },
        {
          "command": "gw.refreshAgentTasks",
          "when": "view == gwAgentTasks",
          "group": "navigation"
        },
        {
          "command": "gw.sortAgentTasks",
          "when": "view == gwAgentTasks",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gw.openWorktree",
          "when": "view == gwWorktreeExplorer && viewItem == worktree",
          "group": "inline@1"
        },
        {
          "command": "gw.openWorktreeInCurrentWindow",
          "when": "view == gwWorktreeExplorer && viewItem == worktree",
          "group": "navigation@1"
        },
        {
          "command": "gw.openWorktree",
          "when": "view == gwWorktreeExplorer && viewItem == worktree",
          "group": "navigation@2"
        },
        {
          "command": "gw.sync",
          "when": "view == gwWorktreeExplorer && viewItem == worktree",
          "group": "actions@1"
        },
        {
          "command": "gw.removeWorktree",
          "when": "view == gwWorktreeExplorer && viewItem == worktree",
          "group": "danger@1"
        },
        {
          "command": "gw.openPlan",
          "when": "view == gwAgentTasks && viewItem == agentBranch",
          "group": "inline@1"
        },
        {
          "command": "gw.openWalkthrough",
          "when": "view == gwAgentTasks && viewItem == agentBranchCompleted",
          "group": "inline@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gw.switchWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w"
      },
      {
        "command": "gw.focus",
        "key": "ctrl+shift+g w",
        "mac": "cmd+shift+g w",
        "when": "!editorFocus"
      },
      {
        "command": "gw.focusAgentTasks",
        "key": "ctrl+shift+g a",
        "mac": "cmd+shift+g a",
        "when": "!editorFocus"
      }
    ],
    "configuration": {
      "title": "gw",
      "properties": {
        "gw.autoOpenWalkthrough": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open walkthrough.md when it is created"
        },
        "gw.watchInterval": {
          "type": "number",
          "default": 3000,
          "description": "Interval in milliseconds for watching file changes (task.md, plan.md, etc.)"
        },
        "gw.showBareWorktree": {
          "type": "boolean",
          "default": false,
          "description": "Show the bare repository entry in the worktree list"
        },
        "gw.openMarkdownInPreview": {
          "type": "boolean",
          "default": false,
          "description": "Open task.md, plan.md, and walkthrough.md files in Markdown preview mode instead of text editor"
        },
        "gw.agentTasksSortBy": {
          "type": "string",
          "default": "date",
          "enum": [
            "date",
            "name",
            "status"
          ],
          "enumDescriptions": [
            "Sort by modification date",
            "Sort by branch name",
            "Sort by workflow status (in-progress first)"
          ],
          "description": "How to sort agent tasks in the sidebar"
        },
        "gw.agentTasksSortOrder": {
          "type": "string",
          "default": "desc",
          "enum": [
            "asc",
            "desc"
          ],
          "enumDescriptions": [
            "Ascending (oldest/A-Z first)",
            "Descending (newest/Z-A first)"
          ],
          "description": "Sort order for agent tasks"
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "20.19.9",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "vitest": "4.0.9"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
