{
  "name": "vscode-gw",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/vscode-gw/src",
  "projectType": "application",
  "tags": ["vscode-extension"],
  "targets": {
    "version": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./scripts/version.sh",
        "cwd": "packages/vscode-gw"
      },
      "configurations": {
        "dry-run": {
          "command": "./scripts/version.sh --dry-run"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "node esbuild.config.mjs",
        "cwd": "packages/vscode-gw"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node esbuild.config.mjs --watch",
        "cwd": "packages/vscode-gw"
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "outputs": ["{workspaceRoot}/dist/packages/vscode-gw/*.vsix"],
      "options": {
        "commands": [
          "mkdir -p ../../dist/packages/vscode-gw",
          "npx @vscode/vsce package --no-dependencies -o ../../dist/packages/vscode-gw/"
        ],
        "cwd": "packages/vscode-gw",
        "parallel": false
      }
    },
    "release": {
      "executor": "nx:run-commands",
      "dependsOn": ["package"],
      "options": {
        "commands": [
          "npx @vscode/vsce publish --no-dependencies -i $(ls ../../dist/packages/vscode-gw/*.vsix | head -1)",
          "npx ovsx publish $(ls ../../dist/packages/vscode-gw/*.vsix | head -1)"
        ],
        "cwd": "packages/vscode-gw",
        "parallel": false
      },
      "configurations": {
        "ci": {
          "commands": [
            "npx @vscode/vsce publish --no-dependencies -i $(ls ../../dist/packages/vscode-gw/*.vsix | head -1)",
            "npx ovsx publish $(ls ../../dist/packages/vscode-gw/*.vsix | head -1) || echo 'Open VSX publish skipped (no OVSX_PAT)'"
          ]
        },
        "dry-run": {
          "commands": [
            "echo 'Dry run: would publish' $(ls ../../dist/packages/vscode-gw/*.vsix | head -1)",
            "npx @vscode/vsce verify-pat gw-tools || echo 'PAT verification skipped'"
          ]
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/vscode-gw"
      }
    }
  }
}
