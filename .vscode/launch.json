{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run vscode-gw Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-gw"],
      "outFiles": ["${workspaceFolder}/packages/vscode-gw/dist/**/*.js"],
      "preLaunchTask": "Watch vscode-gw"
    },
    {
      "name": "Run vscode-gw Extension (No Watch)",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-gw"],
      "outFiles": ["${workspaceFolder}/packages/vscode-gw/dist/**/*.js"]
    }
  ]
}
